{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Icon": "Images/actions/breakout",
      "Name": "Breakout",
      "States": [
        {
          "Image": "Images/breakout",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Breakout game on the touch strip. Rotate dial to move the paddle, press to start.",
      "UUID": "com.odiestudio.minigame.breakout",
      "PropertyInspectorPath": "PropertyInspector/Breakout/index.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "Layouts/breakout.json",
        "StackColor": "#FF4C4C",
        "TriggerDescription": {
          "Rotate": "Move paddle",
          "Push": "Start / launch / pause",
          "Touch": "Start / launch / pause",
          "LongTouch": "Restart"
        }
      }
    },
    {
      "Icon": "Images/actions/snake",
      "Name": "Snake",
      "States": [
        {
          "Image": "Images/snake",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Snake game on the touch strip. Rotate dial to turn, press to start.",
      "UUID": "com.odiestudio.minigame.snake",
      "PropertyInspectorPath": "PropertyInspector/Snake/index.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "Layouts/snake.json",
        "StackColor": "#5AD65A",
        "TriggerDescription": {
          "Rotate": "Turn left / right",
          "Push": "Start / pause",
          "Touch": "Start / pause",
          "LongTouch": "Restart"
        }
      }
    },
    {
      "Icon": "Images/actions/foosball",
      "Name": "Foosball",
      "States": [
        {
          "Image": "Images/foosball",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "2-player foosball across the whole touch strip. Put it on all 4 dials: RED uses dial 1 + 3, BLUE uses dial 2 + 4.",
      "UUID": "com.odiestudio.minigame.foosball",
      "PropertyInspectorPath": "PropertyInspector/Foosball/index.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "Layouts/foosball.json",
        "StackColor": "#1F6B32",
        "TriggerDescription": {
          "Rotate": "Move rods",
          "Push": "Kick (hold = lift) / start",
          "Touch": "Pause / resume",
          "LongTouch": "Back to title"
        }
      }
    },
    {
      "Icon": "Images/actions/racer",
      "Name": "Sunset Racer",
      "States": [
        {
          "Image": "Images/racer",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Retro arcade racing on the touch strip. Rotate dial to steer, press dial to boost (3 per race).",
      "UUID": "com.odiestudio.minigame.racer",
      "PropertyInspectorPath": "PropertyInspector/Racer/index.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "Layouts/racer.json",
        "StackColor": "#FF8C20",
        "TriggerDescription": {
          "Rotate": "Steer",
          "Push": "Start / boost",
          "Touch": "Pause / resume",
          "LongTouch": "Back to title"
        }
      }
    },
    {
      "Icon": "Images/actions/racer4p",
      "Name": "Sunset Racer 4P",
      "States": [
        {
          "Image": "Images/racer4p",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "4-player split-screen race. Put it on all 4 dials: dial n is player n. Press to join, rotate to steer, press to boost (3 per race).",
      "UUID": "com.odiestudio.minigame.racer4p",
      "PropertyInspectorPath": "PropertyInspector/Racer4P/index.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "Layouts/racer.json",
        "StackColor": "#FF8C20",
        "TriggerDescription": {
          "Rotate": "Steer",
          "Push": "Join / boost",
          "Touch": "Start now / pause",
          "LongTouch": "Back to lobby"
        }
      }
    },
    {
      "Icon": "Images/actions/racermap",
      "Name": "Racer Map",
      "States": [
        {
          "Image": "Images/racermap",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Live track map for Sunset Racer / Racer 4P. Put it on several keys and they join into one big map. Press to zoom on the leader.",
      "UUID": "com.odiestudio.minigame.racermap",
      "Controllers": [
        "Keypad"
      ]
    }
  ],
  "Author": "odie studio",
  "Description": "Retro arcade games for the Stream Deck+ dials and touch strip",
  "URL": "https://github.com/diolinodie/sd-mini-game",
  "Name": "Sunset Arcade",
  "Icon": "Images/pluginIcon",
  "Version": "2.0.0.0",
  "CodePath": "bin/plugin.js",
  "Category": "Sunset Arcade",
  "CategoryIcon": "Images/categoryIcon",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.odiestudio.minigame"
}