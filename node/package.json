{
  "name": "sunset-arcade",
  "version": "2.0.0",
  "private": true,
  "description": "Sunset Arcade Stream Deck+ plugin, Node.js version",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.odiestudio.minigame.dev\"",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.odiestudio.minigame.dev.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^24.19.2",
    "rollup": "^4.64.10",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  }
}
